APP_NAME=Reacti
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated list of browser origins allowed to call /api/* (CORS).
# Defaults (in config/cors.php) to the reacti.io web origins; the native app
# is unaffected (it sends no Origin header). Add local dev origins here if a
# browser client needs them, e.g. http://localhost:3000.
CORS_ALLOWED_ORIGINS=https://reacti.io,https://www.reacti.io,https://staging.reacti.io

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reacti
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
BROADCAST_CONNECTION=pusher
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
# Send session cookies only over HTTPS. Defaults to true outside local dev
# (see config/session.php); set false only for plain-HTTP local development.
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@reacti.io"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS S3 (for media uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# --- JWT (tymon/jwt-auth) ---
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160

# --- Pusher (production realtime) ---
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Vite (frontend build) needs these mirrored
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Reverb (self-hosted alternative; usually disabled in prod) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Firebase Cloud Messaging (server-side push) ---
# Path to the Firebase service account JSON file (NOT the file itself).
# Keep that file outside the repo, e.g. storage/app/firebase/credentials.json
FIREBASE_CREDENTIALS=storage/app/firebase/credentials.json
FIREBASE_PROJECT=reacti-app

# --- Social login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=

# --- Stripe (Cashier; only needed if billing is enabled) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Mobile App-Key gate ---
# The mobile client sends this in the "App-Key" header on every request.
# Generate a new random one for each environment.
APP_KEY_VALUE=
