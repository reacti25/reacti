#!/bin/sh
# Role switch for the Reacti image. The image's default command runs the web
# server; a task that needs another role runs `reacti <role>` instead. The
# image entrypoint has already run the start-up automations (config cache)
# before this executes.
#
#   reacti reverb      websocket server on 0.0.0.0:8080
#   reacti worker      queue worker (no --max-time: an exiting essential
#                      container would stop the ECS task; deploys replace it)
#   reacti scheduler   schedule:work
#   reacti migrate     one-off: migrate --force --isolated
#   reacti dbload      one-off: stream a .sql dump at DUMP_URL into the DB
#   reacti <anything>  run it as given (e.g. reacti php artisan tinker)
set -eu
cd "${APP_BASE_DIR:-/var/www/html}"

case "${1:-}" in
  reverb)    exec php artisan reverb:start --host=0.0.0.0 --port=8080 ;;
  worker)    exec php artisan queue:work --tries=3 --sleep=3 ;;
  scheduler) exec php artisan schedule:work ;;
  migrate)   exec php artisan migrate --force --isolated ;;
  dbload)
    : "${DUMP_URL:?DUMP_URL must be a (presigned) URL of the .sql dump}"
    # MYSQL_ATTR_SSL_CA is the same variable PDO uses; empty means plain TCP
    # (the compose stack), set means TLS with that CA (RDS).
    exec sh -c 'curl -fsSL "$DUMP_URL" | mysql ${MYSQL_ATTR_SSL_CA:+--ssl-ca="$MYSQL_ATTR_SSL_CA"} \
      -h "$DB_HOST" -P "${DB_PORT:-3306}" -u "$DB_USERNAME" -p"$DB_PASSWORD" "$DB_DATABASE"'
    ;;
  "")        echo "usage: reacti reverb|worker|scheduler|migrate|dbload|<command...>" >&2; exit 64 ;;
  *)         exec "$@" ;;
esac
