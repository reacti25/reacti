# Env contract for the AWS containers (migration plan step 2.3).
#
# Every variable the image reads on AWS, one per line, with the production
# value where it is not environment-specific. A line ending in `# secret`
# is an SSM SecureString at /reacti/<env>/<NAME> injected as an ECS
# `secret`; every other line is a plain task-definition `environment`
# value. Comments after a value say what differs on staging.
#
# tests/Feature/Ops/EnvContractTest.php keeps this file in step with the
# code (every name here is read somewhere) and with infra/compose.aws.yaml
# (the stack sets nothing the contract does not know). Phase 3 adds the
# same check for the rendered task definitions.
#
# Not here on purpose: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (the task
# role provides S3 credentials), AWS_ENDPOINT / AWS_USE_PATH_STYLE_ENDPOINT
# (emulator only), REDIS_* (no Redis on AWS), VITE_* (build time).

# App
APP_NAME=Reacti
APP_ENV=production                 # staging: staging
APP_DEBUG=false
APP_KEY=                           # secret
APP_URL=https://reacti.io          # staging: https://staging.reacti.io
LOG_CHANNEL=stderr
LOG_LEVEL=info
TRUSTED_PROXIES=*
SERVED_BY=aws

# Database (RDS MySQL 8.4, TLS required)
DB_CONNECTION=mysql
DB_HOST=                           # the RDS endpoint
DB_PORT=3306
DB_DATABASE=reacti
DB_USERNAME=reacti_app
DB_PASSWORD=                       # secret
MYSQL_ATTR_SSL_CA=/etc/ssl/rds/global-bundle.pem

# Drivers (database everywhere, no Redis)
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

# Realtime (our Reverb service; the app posts to it over the task network)
BROADCAST_CONNECTION=reverb
BROADCAST_FANOUT=                  # transitional: reverb,reverb_legacy until app 1.8.0 is everywhere
REVERB_APP_ID=
REVERB_APP_KEY=                    # the client key, shipped in the app binary
REVERB_APP_SECRET=                 # secret
REVERB_HOST=reverb                 # Service Connect name of the reverb service
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_LEGACY_HOST=climbiq-goonclimbers.com   # transitional, removed with BROADCAST_FANOUT
REVERB_LEGACY_PORT=8081

# Media (private S3 bucket behind CloudFront)
MEDIA_DISK=s3
AWS_DEFAULT_REGION=il-central-1
AWS_BUCKET=                        # reacti-prod-media / reacti-staging-media
AWS_URL=https://media.reacti.io    # staging: https://media-staging.reacti.io

# Email (Resend over SMTP, as today)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465                      # implicit TLS; Laravel 11 has no MAIL_ENCRYPTION key
MAIL_USERNAME=resend
MAIL_PASSWORD=                     # secret
MAIL_FROM_ADDRESS=no-reply@reacti.io
MAIL_FROM_NAME=Reacti

# Auth and push
JWT_SECRET=                        # secret
FIREBASE_CREDENTIALS=              # secret (the service-account JSON as one string)
FIREBASE_PROJECT=app

# Analytics and errors
ANALYTICS_ENV=production           # staging: staging
POSTHOG_KEY=                       # secret
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_SAMPLE_RATE=1
ANALYTICS_HASH_SALT=               # secret
SENTRY_LARAVEL_DSN=                # secret
SENTRY_TRACES_SAMPLE_RATE=0.1

# Staging only (unset on production)
STAGING_PRUNE_ENABLED=false        # staging: true
STAGING_SEED_PASSWORD=             # secret, staging only
