<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options used by `flutter build ipa` when packaging the signed
  App Store binary. Bundle id and team id below match
  ios/Runner.xcodeproj/project.pbxproj.

  Manual signing against the "Reacti App Store" provisioning profile for
  com.reacti.app — created once via the App Store Connect API and stored as
  the IOS_PROD_PROVISIONING_PROFILE secret (see ios-release.yml).
-->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store</string>

    <key>teamID</key>
    <string>545264M5P7</string>

    <key>signingStyle</key>
    <string>manual</string>

    <key>provisioningProfiles</key>
    <dict>
        <key>com.reacti.app</key>
        <string>Reacti App Store</string>
    </dict>

    <key>uploadBitcode</key>
    <false/>
    <key>compileBitcode</key>
    <false/>
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
